{
    "name": "order-service",
    "version": "1.0.0",
    "description": "Service for processing orders",
    "main": "/src/index.js",
    "type": "module",
    "keywords": [
        "nodejs",
        "microservices",
        "express",
        "postgresql",
        "redis",
        "event-driven"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Hrothnar/order-processing-system"
    },
    "bugs": {
        "url": "https://github.com/Hrothnar/order-processing-system/issues"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "author": "Kirill Tatarenko",
    "license": "MIT",
    "packageManager": "pnpm@10.30.0",
    "scripts": {
        "build": "rm -rf dist && tsc",
        "start": "node --enable-source-maps --env-file=.env dist/index.js",
        "build:start": "pnpm run build && pnpm run start",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db": "prisma generate && prisma migrate dev",
        "db:start": "prisma migrate deploy && node --enable-source-maps dist/index.js",
        "test:unit": "jest --config ./src/_test/config/jest.unit.config.ts --detectOpenHandles",
        "test:integration": "jest --config ./src/_test/config/jest.integration.config.ts --detectOpenHandles",
        "test:e2e": "jest --config ./src/_test/config/jest.e2e.config.ts --detectOpenHandles",
        "test": "jest --config ./src/_test/config/jest.base.config.ts --detectOpenHandles",
        "test:one": "node ./misc/script/test.one.js"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "8.4.2",
        "@prisma/client": "5.22.0",
        "express": "5.2.1",
        "kafkajs": "2.2.4",
        "prisma": "5.22.0",
        "swagger-ui-express": "5.0.1",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@testcontainers/postgresql": "10.23.0",
        "@types/express": "5.0.1",
        "@types/jest": "29.5.14",
        "@types/node": "22.13.14",
        "@types/swagger-ui-express": "4.1.8",
        "jest": "29.7.0",
        "testcontainers": "11.13.0",
        "ts-jest": "29.3.0",
        "ts-node": "10.9.2",
        "typescript": "5.9.3"
    }
}