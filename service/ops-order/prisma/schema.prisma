generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider      = "postgresql"
  url           = env("DATABASE_URL")
}

model Order {
  id                      Int               @id @default(autoincrement())
  customerId              Int
  currency                String
  address                 String
  orderItemsId            Int
  items                   Item[]            @relation(fields: [orderItemsId], references: [id], onDelete: Cascade)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([customerId])
}

model OrderItems {
  id                      Int               @id @default(autoincrement())
  sku                     String
  quantity                Int
  unitPrice               Int
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model Idempotency {
  id                      Int               @id @default(autoincrement())
  key                     String            @unique
  requestHash             String
  responseStatus          Int
  responseBody            JSONB
  resourceType            String
  resourceId              String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model ProcessedEvents {
  id                      Int               @id @default(autoincrement())
  eventId                 Int
  consumerName            String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model Outbox {
  id                      Int               @id @default(autoincrement())
  eventId                 Int
  aggregateType           String
  aggregateId             String
  eventName               String
  eventVersion            Int
  payload                 JSONB
  status                  String
  retryCount              Int
  occurredAt              DateTime
  publishedAt             DateTime
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([status])
}