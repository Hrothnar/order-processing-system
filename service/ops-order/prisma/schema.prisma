generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAYMENT_AUTHORIZED
  PAYMENT_FAILED
  INVENTORY_RESERVED
  INVENTORY_REJECTED
  FULFILLMENT_REQUESTED
  FULFILLED
  CANCELLED
  COMPLETED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model Order {
  id                String          @id @default(uuid()) @db.Uuid
  customerId        String          @db.Uuid
  status            OrderStatus     @default(PENDING)
  currency          String          @db.Char(3)
  address           String          @db.VarChar(512)
  totalAmount       Decimal         @db.Decimal(12, 2)
  items             OrderItem[]
  failureReason     String?         @db.VarChar(256)

  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt      @db.Timestamptz(3)

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id                BigInt          @id @default(autoincrement())
  orderId           String          @db.Uuid
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku               String          @db.VarChar(64)
  quantity          Decimal         @db.Decimal(12, 2)
  unitPrice         Decimal         @db.Decimal(12, 2)

  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt      @db.Timestamptz(3)

  @@index([orderId])
  @@index([sku])
}

model Idempotency {
  id                BigInt          @id @default(autoincrement())
  key               String          @unique @db.VarChar(128)
  requestHash       String          @db.VarChar(64)
  responseStatus    Int
  responseBody      Json
  resourceType      String          @db.VarChar(32) // "order"
  resourceId        String?         @db.Uuid        // orderId once created
  expiresAt         DateTime        @db.Timestamptz(3)

  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt      @db.Timestamptz(3)

  @@index([expiresAt])
}

model ProcessedEvent {
  id                BigInt          @id @default(autoincrement())
  eventId           String          @db.Uuid
  consumerName      String          @db.VarChar(64)
  processedAt       DateTime        @default(now()) @db.Timestamptz(3)

  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt      @db.Timestamptz(3)

  @@unique([eventId, consumerName])

  @@index([consumerName])
}

model Outbox {
  id                BigInt          @id @default(autoincrement())
  eventId           String          @db.Uuid
  aggregateType     String          @db.VarChar(32) // "order"
  aggregateId       String          @db.Uuid        // orderId
  eventName         String          @db.VarChar(64) // "OrderCreated"
  eventVersion      Int
  payload           Json
  status            OutboxStatus    @default(PENDING)
  retryCount        Int             @default(0)
  lockedBy          String?         @db.VarChar(128)
  occurredAt        DateTime        @default(now()) @db.Timestamptz(3)
  lockedAt          DateTime?       @db.Timestamptz(3)
  nextAttemptAt     DateTime?       @db.Timestamptz(3)
  publishedAt       DateTime?       @db.Timestamptz(3)

  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt      @db.Timestamptz(3)

  @@unique([eventId])

  @@index([status])
  @@index([status, nextAttemptAt, occurredAt])
  @@index([lockedAt])
}